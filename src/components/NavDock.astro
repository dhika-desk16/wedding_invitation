---
import Calendar from "../assets/icons/Calendar.astro";
import Location from "../assets/icons/Location.astro";
import Images from "../assets/icons/Images.astro";
import Gift from "../assets/icons/Gift.astro";
import Email from "../assets/icons/Email.astro";

const items = [
  {
    href: "#acara",
    label: "Acara",
    icon: Calendar,
  },
  {
    href: "#lokasi",
    label: "Lokasi",
    icon: Location,
  },
  {
    href: "#galeri",
    label: "Galeri",
    icon: Images,
  },
  {
    href: "#amplop",
    label: "Hadiah",
    icon: Gift,
  },
  {
    href: "#rsvp",
    label: "RSVP",
    icon: Email,
  },
];
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-4 z-40 flex justify-center px-4 opacity-0 transition-opacity delay-700 duration-700 group-data-[opened]/body:opacity-100"
>
  <nav
    data-nav
    aria-label="nav-section"
    class="pointer-events-auto flex gap-0.5 rounded-full border border-[#c9a961] bg-[#fbf6e9]/85 p-1.5 shadow-[0_15px_35px_-12px_rgba(59,47,31,0.55)] backdrop-blur-md"
  >
    {
      items.map((item) => (
        <a
          href={item.href}
          class="flex flex-col items-center gap-0.5 rounded-full px-3.5 py-1.5 text-[10px] text-[#6b5b43] transition-colors hover:text-[#86671f] data-[active]:bg-[#86671f] data-[active]:text-[#fbf6e9] focus-visible:outline-2 focus-visible:outline-[#86671f]"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <item.icon />
          </svg>
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<script>
  import { bindNav } from "../lib/nav";

  bindNav();
</script>
