---
import Section from './ui/Section.astro';
import TextLink from './ui/TextLink.astro';
import { wedding } from '../data/wedding';
import { mapsEmbedUrl, mapsOpenUrl } from '../lib/maps';

const event = wedding.events.find((e) => e.id === wedding.mapEventId) ?? wedding.events[0];
---

<Section id="lokasi" tone="cream" title={`Lokasi ${event.title.toLowerCase()}`} wide>
  <p class="mb-8 font-medium">{event.venue}<span class="block font-normal text-[#6b5b43]">{event.address}</span></p>
  <iframe
    title={`Peta ${event.venue}`}
    src={mapsEmbedUrl(event.mapQuery)}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
    class="h-[360px] w-full rounded-[2rem] border border-[#c9a961] shadow-[0_25px_60px_-35px_rgba(134,103,31,0.7)] sepia-[0.25] saturate-[0.9]"
  ></iframe>
  <TextLink href={mapsOpenUrl(event.mapQuery)} target="_blank" rel="noopener" class="mt-6 inline-block">
    Buka di Google Maps
  </TextLink>
</Section>
