---
import { Image } from 'astro:assets';
import { wedding } from '../data/wedding';
import { display, reveal } from '../lib/ui';

const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/hero.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = Object.values(modules)[0]?.default;

const nameTone = photo
  ? 'text-[#fbf6e9]'
  : 'bg-gradient-to-b from-[#c9a961] to-[#86671f] bg-clip-text pb-1 text-transparent';

const stars = [
  { left: '8%', top: '10%', size: 6, delay: 0 },
  { left: '22%', top: '18%', size: 4, delay: 0.7 },
  { left: '86%', top: '12%', size: 5, delay: 0.3 },
  { left: '72%', top: '24%', size: 3, delay: 1.1 },
  { left: '12%', top: '44%', size: 4, delay: 1.4 },
  { left: '92%', top: '46%', size: 6, delay: 0.5 },
  { left: '6%', top: '70%', size: 5, delay: 0.9 },
  { left: '88%', top: '72%', size: 4, delay: 1.6 },
  { left: '28%', top: '86%', size: 3, delay: 0.2 },
  { left: '66%', top: '88%', size: 5, delay: 1.2 },
];
---

<header
  class="relative flex min-h-svh items-center justify-center overflow-hidden bg-[radial-gradient(ellipse_at_50%_20%,#fbf6e9,#f5edda_75%)] px-5 pb-28 pt-12 text-center"
>
  <span class="pointer-events-none absolute -left-24 top-1/4 size-72 rounded-full bg-[#e2c57e]/25 blur-3xl"></span>
  <span class="pointer-events-none absolute -right-24 bottom-1/4 size-72 rounded-full bg-[#c9a961]/20 blur-3xl"></span>

  {
    stars.map((star) => (
      <span
        aria-hidden="true"
        class="absolute animate-pulse rounded-full bg-[#c9a961]"
        style={`left:${star.left};top:${star.top};width:${star.size}px;height:${star.size}px;animation-delay:${star.delay}s`}
      />
    ))
  }

  <div
    data-parallax
    class="relative z-10 grid justify-items-center gap-7 [opacity:calc(1-var(--p,0)*0.9)] [translate:0_calc(var(--p,0)*-50px)]"
  >
    <p class:list={[reveal, display, 'text-[1.25rem] italic text-[#86671f] delay-700']}>
      Kami mengundang Anda ke pernikahan
    </p>

    <div
      class:list={[
        reveal,
        'relative grid min-h-[min(62svh,500px)] w-[min(84vw,360px)] place-items-center overflow-hidden rounded-t-full border border-[#c9a961] bg-[#fbf6e9]/60 px-6 pb-12 pt-24 shadow-[0_30px_70px_-35px_rgba(134,103,31,0.7)] delay-[950ms]',
      ]}
    >
      {
        photo && (
          <>
            <Image src={photo} alt="" width={900} class="absolute inset-0 size-full object-cover" />
            <span class="absolute inset-0 bg-gradient-to-t from-[#3b2f1f]/80 via-[#3b2f1f]/20 to-transparent" />
          </>
        )
      }
      <span class="pointer-events-none absolute inset-2 rounded-t-full border border-[#c9a961]/60"></span>

      <h1
        class:list={[
          display,
          nameTone,
          'relative flex flex-col items-center text-[length:clamp(3.6rem,15vw,6rem)] font-medium leading-[0.95]',
        ]}
      >
        <span>{wedding.bride}</span>
        <i class:list={[display, 'text-[0.5em] leading-[1.2]', photo ? 'text-[#e2c57e]' : 'text-[#c9a961]']}>&amp;</i>
        <span>{wedding.groom}</span>
      </h1>
    </div>

    <p class:list={[reveal, 'rounded-full border border-[#c9a961] px-6 py-1.5 tracking-[0.08em] delay-[1300ms]']}>
      {wedding.dateLabel}
    </p>
  </div>

  <div class:list={[reveal, 'absolute inset-x-0 bottom-10 flex justify-center text-[#86671f] delay-[1700ms]']}>
    <svg
      viewBox="0 0 24 24"
      width="26"
      height="26"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="animate-bounce"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>
</header>

<script>
  import { bindParallax } from '../lib/parallax';

  bindParallax();
</script>
